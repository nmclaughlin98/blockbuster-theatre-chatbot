{
  "app": "npx ts-node --prefer-ts-exts lib/stack/app.ts",
  "output": "app",
  "watch": {
    "include": [
      "**"
    ],
    "exclude": [
      "README.md",
      "cdk*.json",
      "node_modules",
      "*.d.ts",
      "*.js",
      "tsconfig.json",
      "package*.json",
      "test",
      "app"
    ]
  },
  "context": {
    "@aws-cdk/aws-lambda:recognizeLayerVersion": true,
    "@aws-cdk/core:checkSecretUsage": true,
    "@aws-cdk/core:target-partitions": [
      "aws",
      "aws-cn"
    ]
  }
}
